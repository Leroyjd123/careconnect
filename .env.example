# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Used for inviting patients. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the app is served. Local: http://localhost:3000. Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web push notifications. Generate once with: npx web-push generate-vapid-keys
# Leave empty to turn notifications off. Use the same pair locally and on Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@yourdomain.com
VAPID_SUBJECT=mailto:no-reply@example.com
